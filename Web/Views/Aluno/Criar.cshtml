@using Domain.Models
@model Web.Models.AlunoFormViewModel

@{
    ViewData["Title"] = "Cadastrar Aluno";
    List<Cidade> cidades = (List<Cidade>)ViewBag.Cidades;
}

<div asp-validation-summary="ModelOnly"></div>
<form asp-controller="Aluno" asp-action="@(Model.IdAluno == 0 ? "Criar" : "Editar")" method="post">
    <input type="hidden" asp-for="IdAluno"/>
    <label>Nome</label>
    <input type="text" asp-for="Nome" maxlength="120">
    <span asp-validation-for="Nome"></span>
    <label>Data de nascimento</label>
    <input type="date" asp-for="DataNascimento" value="@DateTime.Now.ToString("yyyy-MM-dd")">
    <label>Cpf</label>
    <input type="text" asp-for="Cpf">
    <span asp-validation-for="Cpf"></span>
    <label>Cidade</label>
    <select asp-for="CidadeId">
        @foreach (Cidade cidade in cidades)
        {
            <option value="@cidade.Id">@cidade.Nome</option>
        }
    </select>
    <label>Sexo</label>
    <select asp-for="Sexo">
        <option value="0">Masculino</option>
        <option value="1">Feminino</option>
        <option value="2">Outros</option>
    </select>
    <button type="submit">Criar Aluno</button>
</form>